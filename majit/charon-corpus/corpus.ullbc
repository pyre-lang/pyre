},{"DocComment":" assert!(ptr::eq(five_ref, same_five_ref));"},{"DocComment":""},{"DocComment":" assert!(five_ref == other_five_ref);"},{"DocComment":" assert!(!ptr::eq(five_ref, other_five_ref));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Slices are also compared by their length (fat pointers):"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":" assert!(std::ptr::eq(&a[..3], &a[..3]));"},{"DocComment":" assert!(!std::ptr::eq(&a[..2], &a[..3]));"},{"DocComment":" assert!(!std::ptr::eq(&a[0..2], &a[1..3]));"},{"DocComment":" ```"}],"inline":"Always","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"ptr_eq","has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Contravariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Value":[534,{"RawPtr":[{"Deduplicated":2},"Shared"]}]},{"Deduplicated":534}],"output":{"Deduplicated":3}},"src":"Normal","body":"Opaque"},{"def_id":103,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["convert",0]},{"Ident":["num",0]},{"Impl":{"Trait":25}},{"Ident":["from",0]}],"span":{"Untagged":{"data":{"file_id":28,"beg":{"line":166,"col":0},"end":{"line":166,"col":81}},"generated_from_span":{"file_id":28,"beg":{"line":151,"col":12},"end":{"line":151,"col":42}}}},"source_text":null,"attr_info":{"attributes":[{"DocComment":"Converts from [`u16`] to [`u32`] losslessly."}],"inline":"Always","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"R